From 66f3010a5c77ffeedc8b77648e0c54c7f1084fdb Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Tue, 17 Mar 2026 23:23:49 +0000
Subject: [PATCH 2/3] compatibility_matrices: restore old kernel config entries

Add old kernel version configs to the compatibility matrices so they
accept devices with older kernels:

Matrix 5: add kernel_config_p_4.4, kernel_config_q_4.9,
kernel_config_r_4.14, kernel_config_r_4.19
Matrix 6: add kernel_config_q_4.9, kernel_config_s_4.14

These entries reference the kernel config sets restored in
platform_kernel_configs and allow the VTS compatibility check to pass
on devices with 4.4 through 4.19 kernels.

Change-Id: Ia97eb64871b596933aa78964c0810bcc6ea702da
---
 compatibility_matrices/Android.bp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/compatibility_matrices/Android.bp b/compatibility_matrices/Android.bp
index 239ab2f..a0fa939 100644
--- a/compatibility_matrices/Android.bp
+++ b/compatibility_matrices/Android.bp
@@ -96,6 +96,8 @@ vintf_compatibility_matrix {
     kernel_configs: [
         "kernel_config_p_4.4",
         "kernel_config_q_4.9",
+        "kernel_config_r_4.14",
+        "kernel_config_r_4.19",
         "kernel_config_r_5.4",
     ],
 }
@@ -107,6 +109,7 @@ vintf_compatibility_matrix {
         "compatibility_matrix.6.xml",
     ],
     kernel_configs: [
+        "kernel_config_q_4.9",
         "kernel_config_s_4.14",
         "kernel_config_s_4.19",
         "kernel_config_s_5.4",
-- 
2.53.0

