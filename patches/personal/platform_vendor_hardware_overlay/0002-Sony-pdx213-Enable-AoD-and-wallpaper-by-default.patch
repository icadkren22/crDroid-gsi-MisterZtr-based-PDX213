From 0bf9bd2ce8b17a6ea28d3a57ef0c02f110057092 Mon Sep 17 00:00:00 2001
From: Builder <builder@localhost>
Date: Sun, 30 Aug 2026 14:34:00 +0000
Subject: [PATCH 2/3] Sony: pdx213: Enable AoD and wallpaper by default

Enable config_dozeAlwaysOnDisplayAvailable, config_dozeAlwaysOnEnabled,
and config_dozeSupportsAodWallpaper for Sony Xperia 10 III (pdx213)
so Always-on Display with wallpaper is enabled out of the box.
---
 Sony/pdx213/res/values/config.xml | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Sony/pdx213/res/values/config.xml b/Sony/pdx213/res/values/config.xml
index 254e09e..3cfe8ed 100644
--- a/Sony/pdx213/res/values/config.xml
+++ b/Sony/pdx213/res/values/config.xml
@@ -91,4 +91,6 @@
     <bool name="config_dozeAlwaysOnDisplayAvailable">true</bool>
     <bool name="config_powerDecoupleAutoSuspendModeFromDisplay">true</bool>
     <bool name="config_powerDecoupleInteractiveModeFromDisplay">true</bool>
+    <bool name="config_dozeAlwaysOnEnabled">true</bool>
+    <bool name="config_dozeSupportsAodWallpaper">true</bool>
 </resources>
-- 
