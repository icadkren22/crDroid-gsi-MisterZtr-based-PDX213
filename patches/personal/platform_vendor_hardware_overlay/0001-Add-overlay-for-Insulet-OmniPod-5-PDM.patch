From: Evelyn <evelynt@lineageos.org>
Date: Sat, 20 Jun 2026 02:34:10 -0230
Subject: [PATCH 1/3] Add overlay for Insulet OmniPod 5 PDM

---
 Insulet/OmniPod5PDM/Android.mk                |  8 ++
 Insulet/OmniPod5PDM/AndroidManifest.xml       | 10 +++
 Insulet/OmniPod5PDM/res/values/config.xml     | 59 ++++++++++++
 Insulet/OmniPod5PDM/res/xml/power_profile.xml | 90 +++++++++++++++++++
 4 files changed, 167 insertions(+)
 create mode 100644 Insulet/OmniPod5PDM/Android.mk
 create mode 100644 Insulet/OmniPod5PDM/AndroidManifest.xml
 create mode 100644 Insulet/OmniPod5PDM/res/values/config.xml
 create mode 100644 Insulet/OmniPod5PDM/res/xml/power_profile.xml

diff --git a/Insulet/OmniPod5PDM/Android.mk b/Insulet/OmniPod5PDM/Android.mk
new file mode 100644
index 0000000..bef1286
--- /dev/null
+++ b/Insulet/OmniPod5PDM/Android.mk
@@ -0,0 +1,8 @@
+LOCAL_PATH := $(call my-dir)
+include $(CLEAR_VARS)
+LOCAL_MODULE_TAGS := optional
+LOCAL_PACKAGE_NAME := treble-overlay-NUU-N5004LA
+LOCAL_MODULE_PATH := $(TARGET_OUT_PRODUCT)/overlay
+LOCAL_IS_RUNTIME_RESOURCE_OVERLAY := true
+LOCAL_PRIVATE_PLATFORM_APIS := true
+include $(BUILD_PACKAGE)
diff --git a/Insulet/OmniPod5PDM/AndroidManifest.xml b/Insulet/OmniPod5PDM/AndroidManifest.xml
new file mode 100644
index 0000000..2f0108b
--- /dev/null
+++ b/Insulet/OmniPod5PDM/AndroidManifest.xml
@@ -0,0 +1,10 @@
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+        package="me.phh.treble.overlay.NUU.N5004LA"
+        android:versionCode="1"
+        android:versionName="1.0">
+        <overlay android:targetPackage="android"
+        	android:requiredSystemPropertyName="ro.vendor.build.fingerprint"
+        	android:requiredSystemPropertyValue="+*NUU/N5004LA*"
+		android:priority="445"
+		android:isStatic="true" />
+</manifest>
