 Sony/pdx213/res/values/config.xml | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/Sony/pdx213/res/values/config.xml b/Sony/pdx213/res/values/config.xml
index 3cfe8ed..11b4c7f 100644
--- a/Sony/pdx213/res/values/config.xml
+++ b/Sony/pdx213/res/values/config.xml
@@ -93,4 +93,7 @@
     <bool name="config_powerDecoupleInteractiveModeFromDisplay">true</bool>
     <bool name="config_dozeAlwaysOnEnabled">true</bool>
     <bool name="config_dozeSupportsAodWallpaper">true</bool>
+    <bool name="config_intrusiveNotificationLed">true</bool>
+    <integer name="config_defaultNotificationLedOn">500</integer>
+    <integer name="config_defaultNotificationLedOff">2000</integer>
 </resources>
