From 0ce1717fc52ec463d308c5723cd09af21d35c65b Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sun, 26 Apr 2026 16:07:16 +0100
Subject: [PATCH 8/9] tethering: default to modern DNS resolver instead of
 dnsmasq

On GSI builds dnsmasq may not start or communicate properly with the
vendor kernel/tethering stack. The modern NetworkStackService DNS
resolver (tetherDnsProxy) does not depend on dnsmasq and is more
reliable. Set usingLegacyDnsProxy=false for both the initial tetherStart
call and the retry path.

This removes the need for the fallback patch that retries on dnsmasq
failure, since we now take the modern path from the start.

Issue: #14
---
 .../src/com/android/networkstack/tethering/Tethering.java     | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Tethering/src/com/android/networkstack/tethering/Tethering.java b/Tethering/src/com/android/networkstack/tethering/Tethering.java
index 722e81c2c4..64aa00b8f5 100644
--- a/Tethering/src/com/android/networkstack/tethering/Tethering.java
+++ b/Tethering/src/com/android/networkstack/tethering/Tethering.java
@@ -2090,12 +2090,12 @@ public class Tethering {
             final String[] dhcpRanges = cfg.useLegacyDhcpServer()
                     ? cfg.legacyDhcpRanges : new String[0];
             try {
-                NetdUtils.tetherStart(mNetd, true /** usingLegacyDnsProxy */, dhcpRanges);
+                NetdUtils.tetherStart(mNetd, false /** usingLegacyDnsProxy */, dhcpRanges);
             } catch (RemoteException | ServiceSpecificException e) {
                 try {
                     // Stop and retry.
                     mNetd.tetherStop();
-                    NetdUtils.tetherStart(mNetd, true /** usingLegacyDnsProxy */, dhcpRanges);
+                    NetdUtils.tetherStart(mNetd, false /** usingLegacyDnsProxy */, dhcpRanges);
                 } catch (RemoteException | ServiceSpecificException ee) {
                     mLog.e(ee);
                     transitionTo(mStartTetheringErrorState);
-- 
