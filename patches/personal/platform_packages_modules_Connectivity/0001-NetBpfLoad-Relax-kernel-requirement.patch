Subject: [PATCH 1/6] NetBpfLoad: Relax kernel requirement

Signed-off-by: Pranav Vashi <neobuddy89@gmail.com>
---
 bpf/loader/NetBpfLoad.cpp | 16 ----------------
 1 file changed, 16 deletions(-)

diff --git a/bpf/loader/NetBpfLoad.cpp b/bpf/loader/NetBpfLoad.cpp
index ce113d8..117cd47 100644
--- a/bpf/loader/NetBpfLoad.cpp
+++ b/bpf/loader/NetBpfLoad.cpp
@@ -1673,22 +1673,6 @@ static int doLoad(char** argv, char * const envp[]) {
             bad = true;
         }
 
-#define REQUIRE(maj, min, sub) \
-        if (isKernelVersion(maj, min) && !isAtLeastKernelVersion(maj, min, sub)) { \
-            ALOGW("Android V+ requires %d.%d kernel to be %d.%d.%d+.", maj, min, maj, min, sub); \
-            bad = true; \
-        }
-
-        REQUIRE(4, 19, 236)
-        REQUIRE(5, 4, 186)
-        REQUIRE(5, 10, 199)
-        REQUIRE(5, 15, 136)
-        REQUIRE(6, 1, 57)
-        REQUIRE(6, 6, 0)
-        REQUIRE(6, 12, 0)
-
-#undef REQUIRE
-
         if (bad) {
             ALOGE("Unsupported kernel version (%07x).", kernelVer);
         }
