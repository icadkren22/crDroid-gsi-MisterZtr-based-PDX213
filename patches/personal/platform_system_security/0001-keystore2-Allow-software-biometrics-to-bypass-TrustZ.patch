From e2951766b30f4e0d31a7e54f8a446aef2949b5a9 Mon Sep 17 00:00:00 2001
From: Ica <icadkren22@gmail.com>
Date: Tue, 1 Sep 2026 15:14:11 +0000
Subject: [PATCH] keystore2: Allow software biometrics to bypass TrustZone
 KeyMint auth requirement

Change-Id: Iaa71fb3d22ad2b677184d6164af7cd069ad590c4
---
 keystore2/src/operation.rs      | 30 +++++++++++--
 keystore2/src/security_level.rs | 76 ++++++++++++++++++++++++++++-----
 2 files changed, 92 insertions(+), 14 deletions(-)

diff --git a/keystore2/src/operation.rs b/keystore2/src/operation.rs
index 4be8c349..18f34328 100644
--- a/keystore2/src/operation.rs
+++ b/keystore2/src/operation.rs
@@ -393,7 +393,16 @@ impl Operation {
         let output = self
             .update_outcome(&mut outcome, {
                 let _wp = self.watch("Operation::update: calling IKeyMintOperation::update");
-                map_km_error(self.km_op.update(input, hat.as_ref(), tst.as_ref()))
+                let res = map_km_error(self.km_op.update(input, hat.as_ref(), tst.as_ref()));
+                if let Err(Error::Km(ErrorCode::KEY_USER_NOT_AUTHENTICATED)) = &res {
+                    if hat.is_some() {
+                        map_km_error(self.km_op.update(input, None, tst.as_ref()))
+                    } else {
+                        res
+                    }
+                } else {
+                    res
+                }
             })
             .context(ks_err!("Update failed for {:?}", self.owner))?;
 
@@ -423,13 +432,28 @@ impl Operation {
         let output = self
             .update_outcome(&mut outcome, {
                 let _wp = self.watch("Operation::finish: calling IKeyMintOperation::finish");
-                map_km_error(self.km_op.finish(
+                let res = map_km_error(self.km_op.finish(
                     input,
                     signature,
                     hat.as_ref(),
                     tst.as_ref(),
                     confirmation_token.as_deref(),
-                ))
+                ));
+                if let Err(Error::Km(ErrorCode::KEY_USER_NOT_AUTHENTICATED)) = &res {
+                    if hat.is_some() {
+                        map_km_error(self.km_op.finish(
+                            input,
+                            signature,
+                            None,
+                            tst.as_ref(),
+                            confirmation_token.as_deref(),
+                        ))
+                    } else {
+                        res
+                    }
+                } else {
+                    res
+                }
             })
             .context(ks_err!("Finish failed for {:?}", self.owner))?;
 
diff --git a/keystore2/src/security_level.rs b/keystore2/src/security_level.rs
index 744d3a80..5b74ac6a 100644
--- a/keystore2/src/security_level.rs
+++ b/keystore2/src/security_level.rs
@@ -127,6 +127,7 @@ impl KeystoreSecurityLevel {
         creation_result: KeyCreationResult,
         user: AndroidUserId,
         flags: Option<i32>,
+        requested_params: &[KeyParameter],
     ) -> Result<KeyMetadata> {
         let KeyCreationResult {
             keyBlob: key_blob,
@@ -163,6 +164,31 @@ impl KeystoreSecurityLevel {
 
         let mut key_parameters = key_characteristics_to_internal(key_characteristics);
 
+        // If we are injecting software auth tags (USER_SECURE_ID etc.), remove any
+        // NO_AUTH_REQUIRED tag that KeyMint may have echoed back, to avoid the
+        // "key has both NO_AUTH_REQUIRED and USER_SECURE_ID" enforcements conflict.
+        let needs_software_auth = requested_params.iter().any(|p| {
+            p.tag == Tag::USER_AUTH_TYPE
+                || p.tag == Tag::USER_SECURE_ID
+                || p.tag == Tag::AUTH_TIMEOUT
+        });
+        if needs_software_auth {
+            key_parameters.retain(|kp| kp.get_tag() != Tag::NO_AUTH_REQUIRED);
+        }
+
+        for aidl_kp in requested_params.iter() {
+            if (aidl_kp.tag == Tag::USER_AUTH_TYPE
+                || aidl_kp.tag == Tag::USER_SECURE_ID
+                || aidl_kp.tag == Tag::AUTH_TIMEOUT)
+                && !key_parameters.iter().any(|kp| kp.get_tag() == aidl_kp.tag)
+            {
+                key_parameters.push(KsKeyParam::new(
+                    aidl_kp.clone().into(),
+                    SecurityLevel::SOFTWARE,
+                ));
+            }
+        }
+
         key_parameters
             .push(KsKeyParam::new(KsKeyParamValue::UserID(user.0), SecurityLevel::SOFTWARE));
 
@@ -573,6 +599,20 @@ impl KeystoreSecurityLevel {
             .add_required_parameters(caller_uid, params, &key)
             .context(ks_err!("Trying to get aaid."))?;
 
+        let km_params: Vec<KeyParameter> = params
+            .iter()
+            .filter(|p| {
+                p.tag != Tag::USER_AUTH_TYPE
+                    && p.tag != Tag::USER_SECURE_ID
+                    && p.tag != Tag::AUTH_TIMEOUT
+            })
+            .cloned()
+            .chain(std::iter::once(KeyParameter {
+                tag: Tag::NO_AUTH_REQUIRED,
+                value: KeyParameterValue::BoolValue(true),
+            }))
+            .collect();
+
         let creation_result = match attestation_key_info {
             Some(AttestationKeyInfo::UserGenerated {
                 key_id_guard,
@@ -584,7 +624,7 @@ impl KeystoreSecurityLevel {
                     Some(key_id_guard),
                     &KeyBlob::Ref(&blob),
                     blob_metadata.km_uuid().copied(),
-                    &params,
+                    &km_params,
                     |blob| {
                         let attest_key = Some(AttestationKey {
                             keyBlob: blob.to_vec(),
@@ -599,14 +639,14 @@ impl KeystoreSecurityLevel {
                                 ),
                                 5000, // Generate can take a little longer.
                             );
-                            self.keymint.generateKey(&params, attest_key.as_ref())
+                            self.keymint.generateKey(&km_params, attest_key.as_ref())
                         })
                     },
                 )
                 .context(ks_err!(
                     "While generating with a user-generated \
                       attestation key, params: {:?}.",
-                    log_security_safe_params(&params)
+                    log_security_safe_params(&km_params)
                 ))
                 .map(|(result, _)| result),
             Some(AttestationKeyInfo::RkpdProvisioned { attestation_key, attestation_certs }) => {
@@ -624,14 +664,14 @@ impl KeystoreSecurityLevel {
                             attestKeyParams: vec![],
                             issuerSubjectName: attestation_key.issuerSubjectName.clone(),
                         });
-                        self.keymint.generateKey(&params, dynamic_attest_key.as_ref())
+                        self.keymint.generateKey(&km_params, dynamic_attest_key.as_ref())
                     })
                 })
                 .context(ks_err!(
                     "While generating Key {:?} with remote \
                     provisioned attestation key and params: {:?}.",
                     key.alias,
-                    log_security_safe_params(&params)
+                    log_security_safe_params(&km_params)
                 ))
                 .map(|(mut result, _)| {
                     if read_bool("remote_provisioning.use_cert_processor", false).unwrap_or(false) {
@@ -669,18 +709,18 @@ impl KeystoreSecurityLevel {
                     ),
                     5000, // Generate can take a little longer.
                 );
-                self.keymint.generateKey(&params, None)
+                self.keymint.generateKey(&km_params, None)
             })
             .context(ks_err!(
                 "While generating without a provided \
                  attestation key and params: {:?}.",
-                log_security_safe_params(&params)
+                log_security_safe_params(&km_params)
             )),
         }
         .context(ks_err!())?;
 
         let user = caller_uid.owning_user();
-        self.store_new_key(key, creation_result, user, Some(flags)).context(ks_err!())
+        self.store_new_key(key, creation_result, user, Some(flags), &params).context(ks_err!())
     }
 
     fn import_key(
@@ -730,16 +770,30 @@ impl KeystoreSecurityLevel {
             })
             .context(ks_err!())?;
 
+        let km_params: Vec<KeyParameter> = params
+            .iter()
+            .filter(|p| {
+                p.tag != Tag::USER_AUTH_TYPE
+                    && p.tag != Tag::USER_SECURE_ID
+                    && p.tag != Tag::AUTH_TIMEOUT
+            })
+            .cloned()
+            .chain(std::iter::once(KeyParameter {
+                tag: Tag::NO_AUTH_REQUIRED,
+                value: KeyParameterValue::BoolValue(true),
+            }))
+            .collect();
+
         let km_dev = &self.keymint;
         let creation_result = map_km_error({
             let _wp =
                 self.watch("KeystoreSecurityLevel::import_key: calling IKeyMintDevice::importKey.");
-            km_dev.importKey(&params, format, key_data, None /* attestKey */)
+            km_dev.importKey(&km_params, format, key_data, None /* attestKey */)
         })
         .context(ks_err!("Trying to call importKey"))?;
 
         let user = caller_uid.owning_user();
-        self.store_new_key(key, creation_result, user, Some(flags)).context(ks_err!())
+        self.store_new_key(key, creation_result, user, Some(flags), &params).context(ks_err!())
     }
 
     fn import_wrapped_key(
@@ -862,7 +916,7 @@ impl KeystoreSecurityLevel {
             )
             .context(ks_err!())?;
 
-        self.store_new_key(key, creation_result, user, None)
+        self.store_new_key(key, creation_result, user, None, params)
             .context(ks_err!("Trying to store the new key for {user:?}"))
     }
 
-- 
2.43.0

