From 21c405534edb189d7532456589e689ddb118315d Mon Sep 17 00:00:00 2001
From: Ica <icadkren22@gmail.com>
Date: Wed, 2 Sep 2026 05:08:51 +0000
Subject: [PATCH] config: Enable full RGB notification and battery LED
 capabilities

Enable all LED capabilities for devices with RGB LEDs:
- LIGHTS_RGB_NOTIFICATION_LED (1)
- LIGHTS_RGB_BATTERY_LED (2)
- LIGHTS_PULSATING_LED (8)
- LIGHTS_BATTERY_LED (64)

Total: 1 | 2 | 8 | 64 = 75

Without LIGHTS_BATTERY_LED set, LineageBatteryLights.isSupported()
returns false and BatteryService drops charging light completely.
Without LIGHTS_RGB_NOTIFICATION_LED, LineageNotificationLights cannot
auto-generate per-app LED colors from app icons.
---
 lineage/res/res/values/config.xml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/lineage/res/res/values/config.xml b/lineage/res/res/values/config.xml
index 052c2c04..5b31d571 100644
--- a/lineage/res/res/values/config.xml
+++ b/lineage/res/res/values/config.xml
@@ -95,7 +95,7 @@
 
          For example, a device with notification and battery lights that supports
          pulsating and RGB control would set this config to 75. -->
-    <integer name="config_deviceLightCapabilities">8</integer>
+    <integer name="config_deviceLightCapabilities">75</integer>
 
     <!-- Defines external services to be started by the LineageSystemServer at boot. The service itself
          should publish as a binder services in its onStart -->
-- 
